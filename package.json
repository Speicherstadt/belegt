{
  "name": "belegt",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "packageManager": "bun@1.4.5",
  "scripts": {
    "dev:server": "bun --watch server/index.ts",
    "typecheck": "bun run postinstall && tsc -p .",
    "lint": "biome check --error-on-warnings . && checks",
    "format": "biome check --write .",
    "test": "vitest run",
    "dev:app": "vite",
    "build": "vite build",
    "build:demo": "vite build --mode demo && cp dist-demo/index.html dist-demo/404.html",
    "e2e": "playwright test",
    "docs:screenshots": "LANG=de_DE.UTF-8 LANGUAGE=de DOKU_SCREENSHOTS=1 playwright test --project screenshots && bun run docs:social-preview",
    "docs:social-preview": "bun scripts/social-preview/render.ts",
    "postinstall": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --strategy preferredLanguage baseLocale"
  },
  "dependencies": {
    "@better-auth/passkey": "1.7.28",
    "@firsttris/gobd-kern": "https://github.com/Speicherstadt/haben/releases/download/gobd-kern-v0.2.1/firsttris-gobd-kern-0.2.1.tgz",
    "@simplewebauthn/browser": "14.0.0",
    "@tanstack/react-query": "^5.108.4",
    "@tanstack/react-router": "^1.170.46",
    "aws4fetch": "^1.0.20",
    "better-auth": "1.7.28",
    "client-zip": "2",
    "lucide-react": "1.79.0",
    "drizzle-orm": "^0.45.4",
    "fast-xml-parser": "^5.12.1",
    "fflate": "0.8",
    "hono": "^4.13.23",
    "imapflow": "2",
    "nodemailer": "^10.6.1",
    "pdf-lib": "^1.17.1",
    "postal-mime": "4.2.1",
    "postgres": "^4.1.1",
    "pst-extractor": "1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "smtp-server": "3",
    "unpdf": "^2.2.3",
    "zod": "^4.6.7",
    "zxing-wasm": "3.1.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@biomejs/biome": "^2.6.9",
    "@firsttris/checks": "github:firsttris/workflows#v1",
    "@fontsource-variable/geist": "^5.3.0",
    "@inlang/paraglide-js": "^3.2.2",
    "@inlang/plugin-message-format": "^4.6.2",
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/bun": "^1.4.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@types/smtp-server": "^3.5.13",
    "@vitejs/plugin-react": "^6.3.0",
    "drizzle-kit": "^0.31.11",
    "jose": "^6.2.18",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.4.0",
    "vitest": "^5.1.2"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  }
}
