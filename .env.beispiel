# Kopieren nach .env und Werte ersetzen; .env nie einchecken
POSTGRES_PASSWORD=ein-langes-zufaelliges-passwort
BETTER_AUTH_SECRET=mindestens-32-zeichen-zufall-etwa-aus-openssl-rand
BELEGT_SCHLUESSEL=ausgabe-von-openssl-rand-base64-32
BELEGT_URL=http://localhost:3000
