# Versionsnummer des Images, etwa 0.1.0; leer: latest
# BELEGT_VERSION=
# Kopieren nach .env und Werte ersetzen; .env nie einchecken
# Passwörter nur aus Buchstaben und Ziffern (openssl rand -hex 24), sie stehen in den Adressen unten
POSTGRES_PASSWORD=ein-langes-zufaelliges-passwort
# Getrennte Datenbankrollen (docs/betrieb.md): Belegt arbeitet als belegt_app ohne Eigentum an den Tabellen, nur die
# Migrationen laufen als Eigentümer belegt. Bei einer neuen Installation legt Postgres die Rolle beim ersten Start an;
# bei einer bestehenden einmal von Hand (docs/betrieb.md). Ohne die drei Zeilen läuft Belegt wie bisher, mit Warnung.
APP_DB_PASSWORD=ein-zweites-langes-zufaelliges-passwort
DATABASE_URL=postgres://belegt_app:${APP_DB_PASSWORD}@postgres:5432/belegt
MIGRATION_DATABASE_URL=postgres://belegt:${POSTGRES_PASSWORD}@postgres:5432/belegt
BETTER_AUTH_SECRET=mindestens-32-zeichen-zufall-etwa-aus-openssl-rand
BELEGT_SCHLUESSEL=ausgabe-von-openssl-rand-base64-32
BELEGT_URL=http://localhost:3000
# SMTP-Journal (docker compose --profile journal up -d): nur diese Empfänger annehmen, Port nach außen
# SMTP_EMPFAENGER=archiv@belegt.example
# SMTP_PORT=2525
# Microsoft 365 und Google per OAuth (docs/eingang.md)
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT=common
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Anmelden über einen OpenID-Connect-Anbieter und Einbetten (docs/einbetten.md)
# OIDC_ISSUER=https://portal.firma.de/api/auth
# OIDC_CLIENT_ID=belegt
# OIDC_CLIENT_SECRET=
# OIDC_NAME=Firmenkonto
# BELEGT_EMBED_ORIGIN=https://portal.firma.de
# Dateien in S3 mit Object Lock (docs/betrieb.md)
# S3_ENDPUNKT=https://s3.eu-central-1.amazonaws.com
# S3_BUCKET=belegt-archiv
# S3_REGION=eu-central-1
# S3_ZUGANG_ID=
# S3_ZUGANG_GEHEIMNIS=
# S3_PFAD_STIL=false
# S3_SPERRE_TAGE=0
# Zeitstempel nach RFC 3161 über die Kette, einmal am Tag (docs/pruefung.md)
# TSA_URL=https://freetsa.org/tsr
# Vorschläge eines Sprachmodells auf eigenem Server (docker compose --profile ki up -d)
# KI_URL=http://ollama:11434
# KI_MODELL=qwen2.5:7b
# Ansicht als PDF für Word, Excel, PowerPoint und OpenDocument (docker compose --profile vorschau up -d)
# VORSCHAU_URL=http://gotenberg:3000
# Eingangsordner, den der Worker überwacht, etwa für einen Scanner (Volume in compose.yml einkommentieren)
# EINGANG_ORDNER=/var/lib/belegt/eingang
# Unterordner im Eingangsordner als Tags (Steuer/2026/beleg.pdf bekommt „Steuer“ und „2026“)
# EINGANG_ORDNER_TAGS=true
# Inhalt des Codes auf Trennblättern, an denen gescannte Stapel geteilt werden
# TRENNBLATT_CODE=BELEGT-TRENNER
# Knopf „Öffnen mit …“ für eine andere App, die eine Kopie über einen kurzlebigen Link holt (docs/schnittstelle.md)
# OEFFNEN_MIT_NAME=Office im Browser
# OEFFNEN_MIT_URL=https://office.firma.de/oeffnen?datei={url}&name={name}
# Sicherung (docker compose --profile backup up -d): verschlüsselt mit restic, Passwort: openssl rand -base64 32
# An einem zweiten Ort aufbewahren (Passwortmanager); ohne es und BELEGT_SCHLUESSEL ist die Sicherung wertlos.
# RESTIC_PASSWORD=
# Ziel auf einem zweiten System statt im Volume backups, etwa sftp:backup@example.de:/srv/restic/belegt oder
# s3:s3.eu-central-1.amazonaws.com/bucket/belegt (dazu AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY) oder rest:https://…
# RESTIC_REPOSITORY=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Uhrzeit der täglichen Sicherung und Abstand der Test-Restores in Tagen (0 schaltet sie ab)
# BACKUP_TIME=03:15
# RESTORE_CHECK_DAYS=7
