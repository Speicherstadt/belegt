// Renovate (GitHub-App, https://github.com/apps/renovate): ein Pull Request je neuem Release dessen, worauf Belegt
// aufbaut, dazu das Issue „Dependency Dashboard“. Die gemeinsamen Einstellungen aus firsttris/workflows: Minor- und
// Patch-Updates einmal im Monat in einem Pull Request, der sich bei grüner CI selbst merged; Majors auf Anfrage.
// Die CI prüft die Pakete außerdem mit `bun audit`.
// Prüfen mit `bunx --package renovate renovate-config-validator .github/renovate.json5`.
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["github>firsttris/workflows//renovate/default.json5"],
  packageRules: [
    {
      // Better Auth steht fest auf einer Version (Anmeldung, Hooks, Verknüpfung); jedes Update einzeln prüfen
      matchPackageNames: ["better-auth"],
      automerge: false,
    },
    {
      // Postgres läuft in compose.yml, deploy/compose.yml, dem Backup-Image und der CI: Eine neue Major-Version kommt
      // überall zugleich, sonst prüft die CI eine Version, die niemand betreibt (und pg_dump passt nicht zum Server).
      // Für bestehende Installationen braucht sie pg_upgrade oder Dump und Restore.
      matchDatasources: ["docker"],
      matchPackageNames: ["postgres", "library/postgres", "docker.io/library/postgres"],
      matchUpdateTypes: ["major"],
      groupName: "Postgres (major)",
      groupSlug: "postgres",
      automerge: false,
    },
    {
      // Gotenberg (Vorschau von Office-Dateien) in den Compose-Dateien und der CI ebenso nur gemeinsam
      matchDatasources: ["docker"],
      matchPackageNames: ["gotenberg/gotenberg", "docker.io/gotenberg/gotenberg"],
      matchUpdateTypes: ["major"],
      groupName: "Gotenberg (major)",
      groupSlug: "gotenberg",
      automerge: false,
    },
  ],
}
